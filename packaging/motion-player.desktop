[Desktop Entry]
Version=1.0
Type=Application
Name=memory-machine
GenericName=Sensor Video Installation
Comment=Gallery installation: lift headphones to play
Exec=/usr/bin/motion-player-toggle
Icon=motion-player
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=gpio;sensor;motion;video;raspberry;
StartupNotify=true
Actions=Start;Stop;Status;Update;OpenMediaFolder;Debug;ViewLog;

[Desktop Action Start]
Name=Start
Exec=/usr/bin/motion-player-toggle --start

[Desktop Action Stop]
Name=Stop
Exec=/usr/bin/motion-player-toggle --stop

[Desktop Action Status]
Name=Status
Exec=lxterminal --title="memory-machine (status)" -e /usr/bin/motion-player-status

[Desktop Action Update]
Name=Update
Exec=lxterminal --title="memory-machine (update)" -e /usr/bin/motion-player-update

[Desktop Action OpenMediaFolder]
Name=Open media folder
Exec=/usr/bin/motion-player-media

[Desktop Action Debug]
Name=Run with visible log
Exec=lxterminal --title="memory-machine (debug)" -e /usr/bin/motion-player --verbose

[Desktop Action ViewLog]
Name=Open log file
Exec=/usr/bin/motion-player --log
