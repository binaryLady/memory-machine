#!/usr/bin/env bash
# motion-player-prepare: render the piece at the screen's own resolution.
#
# Scaling every frame on a Pi costs more than a continuously looping
# installation can afford. Doing it once here means playback is a straight
# decode and upload: the engine skips scaling entirely when the media already
# matches the output.
set -euo pipefail

MEDIA_DIR="${MEDIA_DIR:-$HOME/memory-machine-media}"
SRC=""
SIZE=""
MODE="fit"
FORCE=0
CRF="${CRF:-18}"
PRESET="${PRESET:-medium}"

usage() {
    cat <<'USAGE'
motion-player-prepare — render the piece at the screen's resolution.

  motion-player-prepare [SRC] [--size 1920x1080] [--mode fit|fill]

  SRC      source clip (default: piece.mp4 in the media folder)
  --size   target resolution (default: what the connected screen reports)
  --force  rebuild even when the outputs are already up to date
  --mode   fit  keep the whole frame, pad with black (default)
           fill cover the screen, crop the overflow
           tile repeat the frame across the screen instead of cropping

Writes SRC.<WxH>.mp4 and its reversed copy, then prints the config lines.
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --size) SIZE="${2:-}"; shift 2 ;;
        --force) FORCE=1; shift ;;
        --mode) MODE="${2:-}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; usage; exit 2 ;;
        *) SRC="$1"; shift ;;
    esac
done

SRC="${SRC:-$MEDIA_DIR/piece.mp4}"

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "ffmpeg is not installed. Run: sudo apt install -y ffmpeg" >&2
    exit 1
fi
if [ ! -f "$SRC" ]; then
    echo "Source clip not found: $SRC" >&2
    exit 1
fi

if [ -z "$SIZE" ]; then
    # Any connected connector, so a DSI or DPI panel counts as the screen.
    for status in /sys/class/drm/card*-*/status; do
        [ "$(cat "$status" 2>/dev/null)" = "connected" ] || continue
        modes="$(dirname "$status")/modes"
        [ -s "$modes" ] || continue
        SIZE="$(head -n1 "$modes")"
        CONN="$(basename "$(dirname "$status")")"
        echo "Using ${CONN#*-}'s reported mode: $SIZE"
        break
    done
fi
if ! printf '%s' "$SIZE" | grep -qE '^[0-9]+x[0-9]+$'; then
    echo "Could not determine a target size. Pass --size 1920x1080." >&2
    exit 2
fi

WIDTH="${SIZE%x*}"
HEIGHT="${SIZE#*x}"

src_dimension() {
    ffprobe -v error -select_streams v:0 -show_entries "stream=$1" \
        -of default=nokey=1:noprint_wrappers=1 "$SRC" 2>/dev/null | head -n1
}

case "$MODE" in
    fit)
        VF="scale=${WIDTH}:${HEIGHT}:force_original_aspect_ratio=decrease,pad=${WIDTH}:${HEIGHT}:(ow-iw)/2:(oh-ih)/2:black"
        ;;
    fill)
        VF="scale=${WIDTH}:${HEIGHT}:force_original_aspect_ratio=increase,crop=${WIDTH}:${HEIGHT}"
        ;;
    tile)
        # Fit the frame to the screen's height, then repeat it across the width
        # rather than cropping away everything that does not fit. Useful when a
        # screen is a far wider shape than the piece and a crop would leave a
        # narrow slice of it.
        SRC_W="$(src_dimension width)"
        SRC_H="$(src_dimension height)"
        if [ -z "$SRC_W" ] || [ -z "$SRC_H" ] || [ "$SRC_H" -eq 0 ]; then
            echo "Could not read the source dimensions; needed to work out the repeat count" >&2
            exit 1
        fi
        SCALED_W=$(( (SRC_W * HEIGHT + SRC_H / 2) / SRC_H ))
        [ "$SCALED_W" -lt 1 ] && SCALED_W=1
        COUNT=$(( (WIDTH + SCALED_W - 1) / SCALED_W ))
        [ "$COUNT" -lt 1 ] && COUNT=1
        echo "Repeating the frame ${COUNT}x across ${WIDTH}px"
        if [ "$COUNT" -eq 1 ]; then
            VF="scale=-2:${HEIGHT},crop=${WIDTH}:${HEIGHT}"
        else
            LABELS=""
            INPUTS=""
            i=0
            while [ "$i" -lt "$COUNT" ]; do
                LABELS="${LABELS}[t${i}]"
                INPUTS="${INPUTS}[t${i}]"
                i=$((i + 1))
            done
            VF="scale=-2:${HEIGHT},split=${COUNT}${LABELS};${INPUTS}hstack=inputs=${COUNT},crop=${WIDTH}:${HEIGHT}"
        fi
        ;;
    *)
        echo "Mode must be fit, fill or tile; got '$MODE'" >&2
        exit 2
        ;;
esac

STEM="${SRC%.*}"
OUT="${STEM}.${SIZE}.mp4"
REVERSE="${STEM}.${SIZE}.reverse.mp4"

# Rendering is minutes of CPU, and these commands get re-run while working
# through a set of cuts. An output already newer than its source is current;
# editing the source brings its rebuild back.
needs_render() {
    if [ "$FORCE" = "1" ] || [ ! -f "$OUT" ]; then
        return 0
    fi
    if [ "$OUT" -nt "$SRC" ]; then
        return 1
    fi
    return 0
}

if needs_render; then
    echo "Rendering $SRC at ${SIZE} (${MODE})..."
    if [ "$MODE" = "tile" ] && [ "${COUNT:-1}" -gt 1 ]; then
        ffmpeg -nostdin -v error -y -i "$SRC" -an -filter_complex "$VF" \
            -c:v libx264 -preset "$PRESET" -crf "$CRF" -pix_fmt yuv420p "$OUT"
    else
        ffmpeg -nostdin -v error -y -i "$SRC" -an -vf "$VF" \
            -c:v libx264 -preset "$PRESET" -crf "$CRF" -pix_fmt yuv420p "$OUT"
    fi
else
    echo "$(basename "$OUT") is newer than $(basename "$SRC"); skipping the render."
fi

echo "Building the reversed copy..."
if [ "$FORCE" = "1" ]; then
    motion-player-reverse "$OUT" "$REVERSE" --force
else
    motion-player-reverse "$OUT" "$REVERSE"
fi

cat <<EOF

Done. Point the config at these:

  [media]
  video_file   = $(basename "$OUT")
  reverse_file = $(basename "$REVERSE")

  [playback]
  scaling      = ${MODE}

The media now matches the output exactly, so playback does no scaling at all.
EOF
