#!/usr/bin/env bash
# motion-player-prepare: render the piece at the screen's own resolution.
#
# Scaling every frame on a Pi costs more than a continuously looping
# installation can afford. Doing it once here means playback is a straight
# decode and upload: the engine skips scaling entirely when the media already
# matches the output.
set -euo pipefail

MEDIA_DIR="${MEDIA_DIR:-$HOME/memory-machine-media}"
SRC=""
SIZE=""
MODE="fit"
FORCE=0
CRF="${CRF:-18}"
PRESET="${PRESET:-medium}"

usage() {
    cat <<'USAGE'
motion-player-prepare — render the piece at the screen's resolution.

  motion-player-prepare [SRC] [--size 1920x1080] [--mode fit|fill] [--apply|--no-apply]

  SRC        source clip (default: piece.mp4 in the media folder)
  --size     target resolution (default: what the connected screen reports)
  --force    rebuild even when the outputs are already up to date
  --mode     fit  keep the whole frame, pad with black (default)
             fill cover the screen, crop the overflow
             tile repeat the frame across the screen instead of cropping
  --apply    point the config at the rendered files without asking
  --no-apply render only; print the config lines instead
  --rotate   cw | ccw — bake a 90-degree turn into the render, for a
             landscape panel mounted portrait (or the reverse). Rotation
             happens once here, not per frame at playback; give --size as
             the panel's native (unrotated) mode, e.g. --size 1280x800
             --rotate cw for a 1280x800 panel standing on its side
  --fx       double-h | mirror-h | mirror-v | kaleidoscope — bake a seamless
             symmetry into the render. double-h sets the whole frame beside
             its own reflection (a ~1:2 portrait doubled becomes a square;
             applied before sizing, since it changes the aspect). mirror-h
             reflects the left half across a vertical center line, mirror-v
             the top half downward, and kaleidoscope mirrors the top-left
             quadrant four ways — those three are applied after sizing, so
             the seam is exact and centered. The output name carries the
             effect: piece.kaleidoscope.WxH.mp4. Does not combine with
             --mode tile.

Writes SRC.<WxH>.mp4 and its reversed copy, then offers to update the config.
A non-default --mode joins the name too: SRC.<WxH>.fill.mp4.
USAGE
}

APPLY=ask
ROTATE=""
FX=""
while [ $# -gt 0 ]; do
    case "$1" in
        --size) SIZE="${2:-}"; shift 2 ;;
        --force) FORCE=1; shift ;;
        --mode) MODE="${2:-}"; shift 2 ;;
        --rotate) ROTATE="${2:-}"; shift 2 ;;
        --fx) FX="${2:-}"; shift 2 ;;
        --apply) APPLY=yes; shift ;;
        --no-apply) APPLY=no; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; usage; exit 2 ;;
        *) SRC="$1"; shift ;;
    esac
done

case "$ROTATE" in
    ""|cw|ccw) ;;
    *) echo "--rotate must be cw or ccw; got '$ROTATE'" >&2; exit 2 ;;
esac

case "$FX" in
    ""|double-h|mirror-h|mirror-v|kaleidoscope) ;;
    *) echo "--fx must be double-h, mirror-h, mirror-v or kaleidoscope; got '$FX'" >&2; exit 2 ;;
esac
if [ -n "$FX" ] && [ "$MODE" = "tile" ]; then
    echo "--fx does not combine with --mode tile" >&2
    exit 2
fi

SRC="${SRC:-$MEDIA_DIR/piece.mp4}"

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "ffmpeg is not installed. Run: sudo apt install -y ffmpeg" >&2
    exit 1
fi
if [ ! -f "$SRC" ]; then
    echo "Source clip not found: $SRC" >&2
    exit 1
fi

if [ -z "$SIZE" ]; then
    # Any connected connector, so a DSI or DPI panel counts as the screen.
    for status in /sys/class/drm/card*-*/status; do
        [ "$(cat "$status" 2>/dev/null)" = "connected" ] || continue
        modes="$(dirname "$status")/modes"
        [ -s "$modes" ] || continue
        SIZE="$(head -n1 "$modes")"
        CONN="$(basename "$(dirname "$status")")"
        echo "Using ${CONN#*-}'s reported mode: $SIZE"
        break
    done
fi
if ! printf '%s' "$SIZE" | grep -qE '^[0-9]+x[0-9]+$'; then
    echo "Could not determine a target size. Pass --size 1920x1080." >&2
    exit 2
fi

WIDTH="${SIZE%x*}"
HEIGHT="${SIZE#*x}"

src_dimension() {
    ffprobe -v error -select_streams v:0 -show_entries "stream=$1" \
        -of default=nokey=1:noprint_wrappers=1 "$SRC" 2>/dev/null | head -n1
}

case "$MODE" in
    fit)
        VF="scale=${WIDTH}:${HEIGHT}:force_original_aspect_ratio=decrease,pad=${WIDTH}:${HEIGHT}:(ow-iw)/2:(oh-ih)/2:black"
        ;;
    fill)
        VF="scale=${WIDTH}:${HEIGHT}:force_original_aspect_ratio=increase,crop=${WIDTH}:${HEIGHT}"
        ;;
    tile)
        # Fit the frame to the screen's height, then repeat it across the width
        # rather than cropping away everything that does not fit. Useful when a
        # screen is a far wider shape than the piece and a crop would leave a
        # narrow slice of it.
        SRC_W="$(src_dimension width)"
        SRC_H="$(src_dimension height)"
        if [ -z "$SRC_W" ] || [ -z "$SRC_H" ] || [ "$SRC_H" -eq 0 ]; then
            echo "Could not read the source dimensions; needed to work out the repeat count" >&2
            exit 1
        fi
        if [ -n "$ROTATE" ]; then
            TMP_W="$SRC_W"; SRC_W="$SRC_H"; SRC_H="$TMP_W"
        fi
        SCALED_W=$(( (SRC_W * HEIGHT + SRC_H / 2) / SRC_H ))
        [ "$SCALED_W" -lt 1 ] && SCALED_W=1
        COUNT=$(( (WIDTH + SCALED_W - 1) / SCALED_W ))
        [ "$COUNT" -lt 1 ] && COUNT=1
        echo "Repeating the frame ${COUNT}x across ${WIDTH}px"
        if [ "$COUNT" -eq 1 ]; then
            VF="scale=-2:${HEIGHT},crop=${WIDTH}:${HEIGHT}"
        else
            LABELS=""
            INPUTS=""
            i=0
            while [ "$i" -lt "$COUNT" ]; do
                LABELS="${LABELS}[t${i}]"
                INPUTS="${INPUTS}[t${i}]"
                i=$((i + 1))
            done
            VF="scale=-2:${HEIGHT},split=${COUNT}${LABELS};${INPUTS}hstack=inputs=${COUNT},crop=${WIDTH}:${HEIGHT}"
        fi
        ;;
    *)
        echo "Mode must be fit, fill or tile; got '$MODE'" >&2
        exit 2
        ;;
esac

# double-h changes the frame's aspect (a ~1:2 portrait doubled is a square),
# so it must run before sizing; the reflective symmetries run after sizing so
# the seam is exact and centered on the final frame. All use filter graph
# labels, hence -filter_complex below.
case "$FX" in
    double-h)
        VF="split[da][db];[db]hflip[dc];[da][dc]hstack,${VF}"
        ;;
    mirror-h)
        VF="${VF},crop=iw/2:ih:0:0,split[fa][fb];[fb]hflip[fc];[fa][fc]hstack"
        ;;
    mirror-v)
        VF="${VF},crop=iw:ih/2:0:0,split[fa][fb];[fb]vflip[fc];[fa][fc]vstack"
        ;;
    kaleidoscope)
        VF="${VF},crop=iw/2:ih/2:0:0,split=4[ka][kb][kc][kd];[kb]hflip[kb1];[kc]vflip[kc1];[kd]hflip,vflip[kd1];[ka][kb1]hstack[kt];[kc1][kd1]hstack[kk];[kt][kk]vstack"
        ;;
esac

# The turn happens here, once, rather than in a compositor transform at
# playback. Prefixed last so it leads the whole chain: rotation before any
# effect or scaling, and --size stays the panel's native mode.
if [ -n "$ROTATE" ]; then
    T=1
    [ "$ROTATE" = "ccw" ] && T=2
    VF="transpose=${T},${VF}"
fi

STEM="${SRC%.*}"
[ -n "$FX" ] && STEM="${STEM}.${FX}"

# The mode decides the framing, so it belongs in the name the way --fx already
# is. Without it a render called 1280x800 is ambiguous between a padded one and
# a cropped one, and re-running with a different --mode finds the old file
# already newer than the master and silently keeps it.
NAME="$SIZE"
[ "$MODE" != "fit" ] && NAME="${SIZE}.${MODE}"
OUT="${STEM}.${NAME}.mp4"
REVERSE="${STEM}.${NAME}.reverse.mp4"

# Rendering is minutes of CPU, and these commands get re-run while working
# through a set of cuts. An output already newer than its source is current;
# editing the source brings its rebuild back.
needs_render() {
    if [ "$FORCE" = "1" ] || [ ! -f "$OUT" ]; then
        return 0
    fi
    if [ "$OUT" -nt "$SRC" ]; then
        return 1
    fi
    return 0
}

if needs_render; then
    echo "Rendering $SRC at ${SIZE} (${MODE})..."
    if { [ "$MODE" = "tile" ] && [ "${COUNT:-1}" -gt 1 ]; } || [ -n "$FX" ]; then
        ffmpeg -nostdin -v error -y -i "$SRC" -an -filter_complex "$VF" \
            -c:v libx264 -preset "$PRESET" -crf "$CRF" -pix_fmt yuv420p "$OUT"
    else
        ffmpeg -nostdin -v error -y -i "$SRC" -an -vf "$VF" \
            -c:v libx264 -preset "$PRESET" -crf "$CRF" -pix_fmt yuv420p "$OUT"
    fi
else
    echo "$(basename "$OUT") is newer than $(basename "$SRC"); skipping the render."
fi

echo "Building the reversed copy..."
if [ "$FORCE" = "1" ]; then
    motion-player-reverse "$OUT" "$REVERSE" --force
else
    motion-player-reverse "$OUT" "$REVERSE"
fi

# The engine only plays files the config names, so the rendered clip must be
# written into [media] to be used at all. Tiled output already matches the
# screen exactly, and "tile" is not a runtime scaling value — fit is.
SCALING="$MODE"
[ "$MODE" = "tile" ] && SCALING=fit

apply_config() {
    local setup
    setup="$(command -v motion-player-setup || true)"
    [ -n "$setup" ] || setup="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/motion-player-setup"
    "$setup" \
        --set "media.video_file=$(basename "$OUT")" \
        --set "media.reverse_file=$(basename "$REVERSE")" \
        --set "playback.scaling=${SCALING}"
}

if [ "$APPLY" = "ask" ] && [ -t 0 ]; then
    printf '\nPoint the config at %s now? [Y/n]: ' "$(basename "$OUT")"
    read -r answer
    case "$answer" in n|N|no|NO) APPLY=no ;; *) APPLY=yes ;; esac
fi

if [ "$APPLY" = "yes" ]; then
    echo
    echo "Updating the config:"
    apply_config
    echo
    echo "The media now matches the output exactly, so playback does no scaling at all."
else
    cat <<EOF

Done. Point the config at these:

  [media]
  video_file   = $(basename "$OUT")
  reverse_file = $(basename "$REVERSE")

  [playback]
  scaling      = ${SCALING}

Or apply them without retyping: rerun with --apply.

If this Pi's media folder serves several screen shapes, add the clip to the
cut list instead — the engine only plays files the config names, so a prepared
cut left out of [media] is never used:

  [media]
  cuts         = ..., $(basename "$OUT")

(Cut choice follows the pinned display_mode. A rotated screen still reads as
its physical shape there, so on one use the video_file lines above.)

The media now matches the output exactly, so playback does no scaling at all.
EOF
fi
