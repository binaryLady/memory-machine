#!/usr/bin/env bash
# Toggle the memory-machine systemd user service.
# Default usage toggles. Pass --start or --stop to force an action.
set -euo pipefail

ACTION="toggle"

for arg in "$@"; do
    case "$arg" in
        --start) ACTION="start" ;;
        --stop)  ACTION="stop" ;;
    esac
done

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

SERVICE="motion-player.service"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/motion-player"

is_active() {
    systemctl --user is-active "$SERVICE" >/dev/null 2>&1
}

run() {
    # The package can replace the unit file underneath a running manager, which
    # otherwise just warns and carries on with the stale copy.
    if systemctl --user show "$SERVICE" -p NeedDaemonReload 2>/dev/null | grep -q "=yes"; then
        systemctl --user daemon-reload
    fi
    systemctl --user "$1" "$SERVICE"
}

# Launched from the desktop icon there is no terminal, so echoing alone looks
# like nothing happened. Say so on screen when a notifier is available.
say() {
    echo "$1"
    # A headless or notifier-less session makes notify-send fail loudly on
    # stderr; the terminal line above is the real output, so keep it quiet.
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="memory-machine" --icon=motion-player \
            "memory-machine" "$1" >/dev/null 2>&1 || true
    fi
}

report_start() {
    if [ "$(settled_state)" = "running" ]; then
        say "memory-machine started."
        return 0
    fi
    say "memory-machine could not start; it exited straight after launching."
    echo
    echo "Last lines of $STATE_DIR/motion-player.log:"
    tail -8 "$STATE_DIR/motion-player.log" 2>/dev/null || echo "  (no log yet)"
    echo
    echo "Full detail: systemctl --user status $SERVICE"
    return 1
}

settled_state() {
    # systemd returns before the engine has opened its window or died.
    sleep 2
    if is_active; then
        echo "running"
    else
        echo "not running"
    fi
}

case "$ACTION" in
    start)
        if is_active; then
            say "memory-machine is already running."
            exit 0
        fi
        # A person asking to start is not a crash loop: clear the start-limit
        # counter a run of quick restarts may have tripped.
        run reset-failed
        run start
        report_start
        ;;
    stop)
        run stop
        say "memory-machine stopped."
        ;;
    toggle)
        if is_active; then
            run stop
            say "memory-machine stopped."
        else
            run reset-failed
            run start
            report_start
        fi
        ;;
esac
